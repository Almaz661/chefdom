# Скопируй в .env и подставь реальные значения для локальной разработки.
# В production (Render) переменные задаются через Dashboard → Environment.

# Pooled connection string из Neon (Dashboard → Connection Details → Pooled).
# Должна содержать ?sslmode=require.
DATABASE_URL=postgres://user:password@host.neon.tech/chefdom?sslmode=require

# Опционально. По умолчанию 3000 локально; на Render берётся из process.env.PORT автоматически.
PORT=3000

# G.19 — OCR.space API ключ для распознавания фото чеков.
# Если не задан — используется публичный ключ 'helloworld' с лимитом
# 1 запрос в 10 секунд (без месячного лимита).
# Для большего объёма — зарегистрируй свой бесплатный ключ
# на https://ocr.space/ocrapi (1 минута, 25 000 запросов/мес).
OCR_SPACE_API_KEY=helloworld
